{
  // Deploy alternativo via Cloudflare Workers (Static Assets): `npm run build && npx wrangler deploy`
  // Para Cloudflare Pages não é necessário: basta apontar o build para `npm run build` e o output para `dist`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gabilazzbeauty",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
